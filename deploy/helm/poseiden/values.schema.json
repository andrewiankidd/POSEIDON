{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "POSEIDEN Helm values",
  "type": "object",
  "properties": {
    "replicaCount": { "const": 1, "description": "SQLite single-writer: must stay 1." },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer" },
        "targetPort": { "type": "integer" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "accessMode": { "type": "string" },
        "size": { "type": "string" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "type": "string", "enum": ["nginx", "istio"] },
        "host": { "type": "string" }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": {
          "type": "string",
          "enum": ["none", "google", "github", "azure", "auth0", "keycloak", "dex"]
        },
        "cookieSecure": { "type": "boolean" }
      }
    }
  }
}
